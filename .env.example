# Copy this file to `.env` and fill in your values.
# `.env` is gitignored and must NEVER be committed.

# Your physionet.org login (required).
PHYSIONET_USER=your_physionet_username

# Optional: PhysioNet password.
# If set, the notebook uses this instead of prompting interactively via getpass.
# Recommended to leave unset and let the notebook prompt securely at runtime.
# PHYSIONET_PASSWORD=your_password_here

# Optional: where to store raw/processed/results/models/figures.
# Defaults to ~/mimic4_study if unset.
# CAS_BASE_DIR=~/mimic4_study
